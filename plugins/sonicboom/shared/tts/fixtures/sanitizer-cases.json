{
  "version": 1,
  "catalogVersion": "2026.10.0",
  "description": "Shared TTS sanitizer cases. Consumed by plugins/sonicboom/shared/tts/sanitizer.test.ts (TypeScript) and plugins/sonicboom/backend/src/policy.rs (Rust). Both implementations must produce `expected` for every case or the parity contract is broken.",
  "defaults": {
    "removeKnownEmotes": true,
    "removeUnicodeEmoji": false,
    "removeInvisibleCharacters": true,
    "collapseWhitespace": true,
    "emoteSpeechMode": "remove",
    "skipEmptyMessages": true
  },
  "cases": [
    {
      "name": "single known emote after text",
      "input": "Hello [laughcry]",
      "expected": "Hello"
    },
    {
      "name": "emote only becomes empty",
      "input": "[laughcry][laughcry]",
      "expected": ""
    },
    {
      "name": "known emote between words",
      "input": "Hello [wow] world",
      "expected": "Hello world"
    },
    {
      "name": "numeric bracket list is not an emote",
      "input": "Array [1,2,3]",
      "expected": "Array [1,2,3]"
    },
    {
      "name": "unknown bracket token is not an emote",
      "input": "Test [debug]",
      "expected": "Test [debug]"
    },
    {
      "name": "spanish text is untouched",
      "input": "Hola señor, ¿cómo estás?",
      "expected": "Hola señor, ¿cómo estás?"
    },
    {
      "name": "japanese text is untouched",
      "input": "こんにちは 世界",
      "expected": "こんにちは 世界"
    },
    {
      "name": "unicode emoji kept by default",
      "input": "Hello 😂",
      "expected": "Hello 😂"
    },
    {
      "name": "whitespace collapsed around a removed emote",
      "input": "Hello   [happy]    world",
      "expected": "Hello world"
    },
    {
      "name": "unicode emoji removed when enabled",
      "input": "Hello 😂",
      "override": { "removeUnicodeEmoji": true },
      "expected": "Hello"
    },
    {
      "name": "emoji only with unicode removal becomes empty",
      "input": "😂😂",
      "override": { "removeUnicodeEmoji": true },
      "expected": ""
    },
    {
      "name": "emoji ZWJ sequence removed as one cluster",
      "input": "a 👨‍👩‍👧 b",
      "override": { "removeUnicodeEmoji": true },
      "expected": "a b"
    },
    {
      "name": "emoji ZWJ sequence kept intact when removal is off",
      "input": "a 👨‍👩‍👧 b",
      "expected": "a 👨‍👩‍👧 b"
    },
    {
      "name": "skin tone modifier removed with its base",
      "input": "good 👍🏽",
      "override": { "removeUnicodeEmoji": true },
      "expected": "good"
    },
    {
      "name": "keycap sequence removed as one cluster",
      "input": "rank 1️⃣",
      "override": { "removeUnicodeEmoji": true },
      "expected": "rank"
    },
    {
      "name": "text-presentation copyright is preserved",
      "input": "© 2026",
      "expected": "© 2026"
    },
    {
      "name": "emoji-presentation copyright is removed",
      "input": "©️ note",
      "override": { "removeUnicodeEmoji": true },
      "expected": "note"
    },
    {
      "name": "shortcode match is case-insensitive",
      "input": "[LaughCry]",
      "expected": ""
    },
    {
      "name": "unclosed bracket is preserved",
      "input": "Hello [laughcry",
      "expected": "Hello [laughcry"
    },
    {
      "name": "empty bracket is preserved",
      "input": "Hello [] world",
      "expected": "Hello [] world"
    },
    {
      "name": "oversized bracket token is preserved",
      "input": "Hello [this-token-is-far-too-long-to-be-an-emote] world",
      "expected": "Hello [this-token-is-far-too-long-to-be-an-emote] world"
    },
    {
      "name": "describe mode speaks the description",
      "input": "Hello [happy] world",
      "override": { "emoteSpeechMode": "describe" },
      "expected": "Hello happy world"
    },
    {
      "name": "emote removal disabled keeps the shortcode",
      "input": "Hello [laughcry]",
      "override": { "removeKnownEmotes": false },
      "expected": "Hello [laughcry]"
    },
    {
      "name": "zero width space is removed",
      "input": "Hello​world",
      "expected": "Helloworld"
    },
    {
      "name": "invisibles kept when removal is disabled",
      "input": "Hello​world",
      "override": { "removeInvisibleCharacters": false },
      "expected": "Hello​world"
    },
    {
      "name": "bidi override is removed",
      "input": "safe‮txet",
      "expected": "safetxet"
    },
    {
      "name": "soft hyphen is removed",
      "input": "co­operate",
      "expected": "cooperate"
    },
    {
      "name": "tab and newline collapse to a single space",
      "input": "line one\n\n\tline two",
      "expected": "line one line two"
    },
    {
      "name": "whitespace collapse disabled only trims nothing",
      "input": "  Hello   [happy]  ",
      "override": { "collapseWhitespace": false },
      "expected": "  Hello     "
    },
    {
      "name": "arabic text is untouched",
      "input": "مرحبا بالعالم",
      "expected": "مرحبا بالعالم"
    },
    {
      "name": "multiple distinct emotes",
      "input": "[wow] [happy] [laughcry]",
      "expected": ""
    },
    {
      "name": "emote adjacent to punctuation",
      "input": "Nice![happy]",
      "expected": "Nice!"
    },
    {
      "name": "legitimate bracketed text beside an emote",
      "input": "[debug] says [happy] ok",
      "expected": "[debug] says ok"
    }
  ]
}
