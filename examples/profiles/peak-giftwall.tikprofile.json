{
  "profileVersion": 1,
  "id": "peak-giftwall",
  "name": "PEAK giftwall",
  "description": "Import, choose the live catalog IDs in each action, then enable each event. Requires peak.game. All rules start disabled so nothing reaches the game until you turn it on. The gift names are editable examples, not a promise about which gifts exist or what they cost.",
  "params": {},
  "templates": [
    {
      "template": {
        "templateVersion": 1,
        "id": "peak-rule-rose",
        "title": "Rose \u2192 safe pickup",
        "description": "Low impact. Pick the item in the action editor, then enable the event. Edit the gift filter if your stream uses a different name.",
        "icon": "gift",
        "actions": [
          {
            "name": "Spawn item",
            "typeId": "peak.game.spawn-item",
            "enabled": true,
            "config": {
              "itemId": "",
              "quantity": 1,
              "positionMode": "random_player"
            }
          }
        ],
        "event": {
          "name": "Rose",
          "enabled": false,
          "trigger": "tiktok.gift",
          "filters": [
            {
              "path": "event.data.giftName",
              "operator": "eq",
              "value": "Rose"
            }
          ],
          "cooldownMs": 10000,
          "cooldownScope": "global",
          "runMode": "all"
        }
      },
      "params": {}
