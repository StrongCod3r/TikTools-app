{
  "profileVersion": 1,
  "id": "repo-gift-mob",
  "name": "R.E.P.O. regalos \u2192 mobs",
  "description": "Listo para tu directo: cada regalo conocido invoca un mob de R.E.P.O. junto a un jugador al azar. Requiere el plugin repo.game, una partida con nivel activo y el servidor REPOapi en marcha. Puedes cambiar el mob y la cantidad desde el editor de acciones; los IDs salen del catalogo /api/catalog/enemies.",
  "params": {},
  "templates": [
    {
      "template": {
        "templateVersion": 1,
        "id": "repo-gift-rose",
        "title": "Rosa \u2192 Pato",
        "description": "Rosa (1 moneda) invoca 1 pato.",
        "icon": "gift",
        "actions": [
          {
            "name": "Invocar Pato",
            "typeId": "repo.game.spawn-enemy",
            "enabled": true,
            "config": {
              "enemyId": "Enemy - Duck",
              "quantity": 1,
              "positionMode": "random_player"
            }
          }
        ],
        "event": {
          "name": "Rosa",
          "enabled": true,
          "trigger": "tiktok.gift",
          "filters": [
            {
              "path": "event.data.giftName",
              "operator": "eq",
              "value": "Rose"
            }
          ],
          "cooldownMs": 10000,
          "cooldownScope": "global",
          "runMode": "all"
        }
      },
      "params": {}
    },
